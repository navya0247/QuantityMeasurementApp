{
  "Jwt": {
    "Key": "QuantityMeasurementApp-SuperSecretKey-MinLength32Chars!!",
    "Issuer": "QuantityMeasurementApp",
    "Audience": "QuantityMeasurementApp",
    "ExpiryHours": 24
  },

  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/auth/{**catch-all}"
        }
      },
      "measurements-route": {
        "ClusterId": "qma-cluster",
        "Match": {
          "Path": "/measurements/{**catch-all}"
        }
      },
      "health-qma-route": {
        "ClusterId": "qma-cluster",
        "Match": {
          "Path": "/qma/health"
        }
      },
      "health-auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/auth-service/health"
        }
      },
      "auth-swagger-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/auth-docs/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/auth-docs" }
        ]
      },
      "qma-swagger-route": {
        "ClusterId": "qma-cluster",
        "Match": {
          "Path": "/qma-docs/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/qma-docs" }
        ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-service": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "qma-cluster": {
        "Destinations": {
          "qma-service": {
            "Address": "http://localhost:5002"
          }
        }
      }
    }
  },

  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5003"
}
